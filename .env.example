# Server
PORT=3000
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Prefer the Session pooler (port 5432) unless you specifically need direct.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Any other Postgres works too, e.g. a local instance:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/chaudhary_samaj
#
# If DATABASE_URL is empty the server falls back to local SQLite
# (server/data/chaudhary-samaj.sqlite).
DATABASE_URL=

# --- Photo storage --------------------------------------------------------
# Both must be set to use Supabase Storage. Create a PUBLIC bucket named
# "profile-photos" first (Storage -> New bucket -> Public).
# SUPABASE_URL is Project Settings -> API -> Project URL.
# SUPABASE_SERVICE_ROLE_KEY is Project Settings -> API -> service_role secret.
# Never expose the service_role key to the client; it bypasses row-level security.
#
# When either is empty, uploads are written to server/uploads/ and served from
# /uploads instead. That is fine for development, but on a host with an
# ephemeral filesystem (Render free tier) those files are lost on each deploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this API, used to build absolute photo URLs and the Razorpay
# return callback. Leave empty locally; set it in production, e.g.
# PUBLIC_API_BASE_URL=https://chaudhary-samaj.onrender.com
PUBLIC_API_BASE_URL=

# --- Frontend -------------------------------------------------------------
# Web frontend API base URL when deploying the Vite app separately.
# Leave empty to use same-origin /api in local or reverse-proxied setups.
VITE_API_URL=

# --- Payments -------------------------------------------------------------
# Razorpay dashboard -> Settings -> API Keys. Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you configure a Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=

# --- Email OTP ------------------------------------------------------------
# Brevo (smtp-relay.brevo.com:587) is what this project uses. Two things catch
# people out:
#   * SMTP_PASS is the generated SMTP key, not the account password.
#   * SMTP_SERVICE must stay EMPTY. It is nodemailer's provider shorthand, and
#     when set the code ignores SMTP_HOST entirely — leaving "gmail" here sends
#     Brevo credentials to Google and fails with a confusing auth error.
# SMTP_SECURE=false with port 587 is correct: that is STARTTLS, not plaintext.
# SMTP_FROM must be an address verified in the provider, or the send is refused.
#
# Brevo also restricts sending by IP (Security -> Authorized IPs). Leave that
# off for hosts without stable outbound IPs, such as Render's free tier —
# otherwise email breaks silently with "525 5.7.1 Unauthorized IP address"
# whenever the host moves.
#
# With no mailer configured, production refuses to issue a code rather than
# returning it to the caller. Development returns it so local work needs no
# SMTP account.
SMTP_SERVICE=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS OTP --------------------------------------------------------------
# MSG91 SMS Service for OTP. If empty, phone OTP runs in test mode and the
# code is returned to the app instead of being texted.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDERID=
