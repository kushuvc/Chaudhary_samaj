# Server
PORT=3000
NODE_ENV=development

# Use this format for Supabase when running this codebase:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?uselibpqcompat=true&sslmode=require
DATABASE_URL=

# Web frontend API base URL when deploying the Vite app separately.
# Leave empty to use same-origin /api in local or reverse-proxied setups.
VITE_API_URL=

# Optional SMTP for OTP emails. If empty, OTP logs to console fallback in non-production.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# MSG91 SMS Service for OTP
MSG91_AUTHKEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_template_id_here
MSG91_SENDERID=your_sender_id_here
