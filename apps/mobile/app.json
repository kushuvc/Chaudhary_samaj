{
  "expo": {
    "name": "Chaudhary Samaj",
    "slug": "chaudhary-samaj-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chaudharysamaj.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chaudharysamaj.mobile",
      "versionCode": 12,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "chaudharysamaj"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "scheme": "chaudharysamaj",
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "16448aee-83dd-4e42-a306-6a55fad2ed02"
      }
    },
    "owner": "kushnew",
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
