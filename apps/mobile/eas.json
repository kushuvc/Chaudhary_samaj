{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "sdk-54",
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://chaudhary-samaj.onrender.com/api"
      }
    },
    "production": {
      "android": {
        "image": "sdk-54",
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://chaudhary-samaj.onrender.com/api"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
