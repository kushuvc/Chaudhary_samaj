{
  "name": "chaudhary-samaj",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "migrate": "node server/migrate.js",
    "db:copy": "node server/copy-db.js",
    "server": "node server/migrate.js && node server/index.js",
    "server:prod": "node server/migrate.js && node server/cluster.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:android": "npm --prefix apps/mobile android",
    "mobile:ios": "npm --prefix apps/mobile ios",
    "mobile:typecheck": "npm --prefix apps/mobile exec -- tsc --noEmit --project apps/mobile/tsconfig.json",
    "mobile:build:apk": "npm --prefix apps/mobile run build:apk",
    "mobile:build:aab": "npm --prefix apps/mobile run build:aab",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "@supabase/storage-js": "^2.105.4",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.4.0",
    "lucide-react": "^1.7.0",
    "multer": "^2.1.1",
    "nodemailer": "^10.0.10",
    "pg": "^8.20.0",
    "razorpay": "^2.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "babel-preset-expo": "^54.0.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true
  }
}
